# ==============================================================================
# Consumer Portal — Multi-stage build
# Node 20 build → nginx:alpine serve
# ==============================================================================

# ── Stage 1: Vite build ───────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY consumer_ui/package*.json ./
RUN npm ci --prefer-offline

COPY consumer_ui/ ./

# VITE_API_BASE_URL is injected at build time so the browser bundle knows where
# to reach the backend. In docker-compose this is http://localhost:8000
# (browser connects directly — not via the internal Docker network).
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build


# ── Stage 2: nginx serve ──────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="Smart-AI-Voice-Agent Consumer Portal"

# SPA routing: all unknown paths fall back to index.html
COPY docker/nginx/consumer.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
